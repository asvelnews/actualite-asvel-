{
  "name": "asvel-tour",
  "version": "1.0.0",
  "private": true,
  "description": "ASVEL TOUR – vidéo Reel 1080x1920 (Remotion) affichant les victoires de l'ASVEL sur la carte de France",
  "type": "module",
  "scripts": {
    "build:map": "node scripts/build-france.mjs",
    "studio": "remotion studio",
    "render": "remotion render AsvelTour out/asvel-tour.mp4 --codec=h264 --crf=16",
    "still": "remotion still AsvelTour out/frame.png --frame=60",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.1.0",
    "@fontsource/barlow-condensed": "^5.1.0",
    "@remotion/cli": "^4.0.536",
    "d3-geo": "^3.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.536"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.0",
    "@types/react": "^18.3.12",
    "topojson-client": "^3.1.0",
    "typescript": "^5.6.3",
    "world-atlas": "^2.0.2"
  }
}
